# /etc/depverify-agent/agent.env (owner root, group depverify-agent, mode 0640)
AGENT_CONSOLE_URL=https://console.example.com
# The console key, pinned: the agent refuses a console signing with another one.
AGENT_CONSOLE_PUBKEY=ed25519:...
# Read once, at the first start; useless afterwards (single-use, or bounded and approved when reusable).
AGENT_TOKEN_FILE=/etc/depverify-agent/token
# Optional: Docker (root-equivalent: prefer a read-only socket proxy), discovery of the containers too.
#AGENT_DOCKER=1
#AGENT_DOCKER_HOST=unix:///var/run/docker.sock
# Optional: a private CA of the console (PEM).
#AGENT_CA_FILE=/etc/depverify-agent/console-ca.pem
